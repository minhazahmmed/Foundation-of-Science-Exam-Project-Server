PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fos-exam
# কমপক্ষে ৩২ অক্ষরের র‍্যান্ডম লেখা। বানাতে: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-text
JWT_EXPIRES_IN=7d

# ফ্রন্টএন্ডের ঠিকানা (CORS আর পরীক্ষার লিংক বানাতে লাগে)
# শেষে / দেবে না। একাধিক হলে কমা দিয়ে লেখো (যেমন লোকাল আর ডিপ্লয় দুটো)
CLIENT_URL=http://localhost:5173

# মূল শিক্ষকের ইমেইল। এই ইমেইলে রেজিস্টার করলে সরাসরি শিক্ষক হবে এবং অন্য শিক্ষকদের অনুমোদন দিতে পারবে।
# deploy করেই আগে এই ইমেইলে নিজে রেজিস্টার করে নিয়ো।
OWNER_EMAIL=minhazahmmed231@gmail.com

# ছবি থেকে প্রশ্ন বের করার জন্য (https://aistudio.google.com/apikey থেকে ফ্রি key নাও)
GEMINI_API_KEY=
# মডেলের নাম। কাজ না করলে Google AI Studio-তে দেখে নতুন Flash মডেলের নাম বসাও
GEMINI_MODEL=gemini-3.5-flash-lite
